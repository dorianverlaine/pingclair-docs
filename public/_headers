# Cloudflare Pages header rules for the built site.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=3600

# 🤖 The Markdown twins are served as plain text. Several agent fetch stacks
# answer `400 Unsupported content-type: text/markdown` for the real media type,
# and the content is the same either way. Clients that ask for Markdown with
# `Accept: text/markdown` still get `text/markdown` from the worker, which is
# what the agent-readiness check looks for.
/*.md
  Content-Type: text/plain; charset=utf-8

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  # Agent discovery, per RFC 8288 and RFC 9727. The API catalog is the index;
  # `describedby` points at the Markdown map of the documentation.
  Link: </.well-known/api-catalog>; rel="api-catalog", </llms.txt>; rel="describedby", </sitemap.xml>; rel="sitemap"

/.well-known/*
  Access-Control-Allow-Origin: *

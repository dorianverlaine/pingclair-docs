---
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import logo from '../assets/logo.png';

/*
 * Starlight's footer holds the edit link, the last-updated stamp, and the
 * previous/next links. This replacement keeps those and adds the site's own
 * footer below, laid out like the reference's: columns of small muted links
 * over a rule, with a copyright line underneath.
 *
 * Its styles are local rather than inherited. Overriding the component means
 * Starlight's own scoped `footer` rules no longer apply, which is what put the
 * edit row and this block on one line.
 */
const repository = 'https://github.com/dorianverlaine/pingclair';
const release = 'v0.2.0-rc.3';
const year = new Date().getFullYear();

const lang = Astro.locals.starlightRoute?.lang ?? 'en';
const locale = Astro.locals.starlightRoute?.locale;
const prefix = locale && locale !== 'root' ? `/${locale}` : '';

const strings: Record<string, { project: string; docs: string; legal: string }> = {
	en: {
		project: 'Project',
		docs: 'Documentation',
		legal: 'is licensed under Apache-2.0.',
	},
	fr: {
		project: 'Projet',
		docs: 'Documentation',
		legal: 'est publié sous licence Apache-2.0.',
	},
	'zh-TW': {
		project: '專案',
		docs: '文件',
		legal: '以 Apache-2.0 授權。',
	},
	'zh-CN': {
		project: '项目',
		docs: '文档',
		legal: '以 Apache-2.0 许可发布。',
	},
	ja: {
		project: 'プロジェクト',
		docs: 'ドキュメント',
		legal: 'は Apache-2.0 で提供されています。',
	},
	ko: {
		project: '프로젝트',
		docs: '문서',
		legal: '는 Apache-2.0 라이선스로 배포됩니다.',
	},
};

const t = strings[lang] ?? strings.en;

const columns = [
	{
		heading: t.project,
		links: [
			{ label: 'GitHub', href: repository },
			{ label: 'Releases', href: `${repository}/releases` },
			{ label: 'Changelog', href: `${repository}/blob/main/CHANGELOG.md` },
			{ label: 'Issues', href: `${repository}/issues` },
		],
	},
	{
		heading: t.docs,
		links: [
			{ label: 'Install', href: `${prefix}/start/install/` },
			{ label: 'Quickstart', href: `${prefix}/start/quickstart/` },
			{ label: 'Reference', href: `${prefix}/reference/directives/` },
			{ label: 'Benchmarks', href: `${prefix}/project/benchmarks/` },
		],
	},
];
---

<footer class="pc-footer-root">
	<div class="meta">
		<EditLink />
		<LastUpdated />
	</div>

	<Pagination />

	<div class="pc-footer">
		<div class="pc-footer__columns">
			<div class="pc-footer__brand">
				<img class="pc-footer__logo" src={logo.src} alt="Pingclair" width="132" height="38" />
				<p class="pc-footer__release">
					<a href={`${repository}/releases/tag/${release}`}>{release}</a>
				</p>
			</div>

			{
				columns.map((column) => (
					<nav class="pc-footer__column" aria-label={column.heading}>
						<h2 class="pc-footer__heading">{column.heading}</h2>
						<ul>
							{column.links.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>

		<div class="pc-footer__legal">
			<p class="pc-footer__copy">
				<span>© {year} Dorian Verlaine</span>
				{/* An icon rather than the address as text: the mailto and the
				    accessible name still carry it. */}
				<a class="pc-footer__mail" href="mailto:me@dorian.page" aria-label="me@dorian.page">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="16"
						height="16"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect>
						<path d="m3.5 7.5 8.5 5.5 8.5-5.5"></path>
					</svg>
				</a>
			</p>
			<p>
				<a href={repository}>Pingclair</a> {t.legal}
			</p>
		</div>
	</div>
</footer>

<style>
	.pc-footer-root {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	/* The edit link and last-updated stamp, as Starlight lays them out. */
	.meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem 3rem;
		margin-top: 3rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	.pc-footer {
		margin-top: 2.5rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}

	.pc-footer__columns {
		display: grid;
		/* Wraps by itself: three columns when there is room, two, then one. */
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 2rem;
	}

	.pc-footer__brand {
		grid-column: 1 / -1;
	}

	@media (min-width: 45rem) {
		.pc-footer__brand {
			grid-column: span 1;
		}

		.pc-footer__columns {
			grid-template-columns: minmax(14rem, 1fr) repeat(2, minmax(9rem, 12rem));
		}
	}

	.pc-footer__logo {
		display: block;
		inline-size: 7.5rem;
		block-size: auto;
		margin-bottom: 0.75rem;
	}

	.pc-footer__release {
		margin: 0;
		font-weight: 600;
	}

	.pc-footer__heading {
		margin: 0 0 0.75rem;
		font-family: var(--sl-font);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		letter-spacing: 0;
		color: var(--sl-color-white);
	}

	.pc-footer__column ul {
		display: grid;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.pc-footer__legal {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sl-color-hairline);
	}

	.pc-footer__legal p {
		margin: 0;
		min-inline-size: 0;
	}

	/* The address sits under the name rather than beside it. */
	.pc-footer__copy {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.pc-footer__mail {
		display: grid;
		place-items: center;
		inline-size: 1.5rem;
		block-size: 1.5rem;
		border-radius: 0.375rem;
	}

	.pc-footer__mail:hover {
		background-color: color-mix(in oklab, var(--sl-color-gray-2) 8%, transparent);
		text-decoration: none;
	}

	.pc-footer a {
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}

	.pc-footer a:hover {
		color: var(--sl-color-white);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
